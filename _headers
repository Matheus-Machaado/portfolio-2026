/*
	X-Frame-Options: DENY
	X-Content-Type-Options: nosniff
	Referrer-Policy: strict-origin-when-cross-origin
	Strict-Transport-Security: max-age=31536000; includeSubDomains
	Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
	Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/assets/img/*
	Cache-Control: public, max-age=31536000, immutable

/assets/og/*
	Cache-Control: public, max-age=31536000, immutable

/assets/certificados/previews/*
	Cache-Control: public, max-age=31536000, immutable

/assets/certificados/pdfs/*
	Cache-Control: public, max-age=2592000

/assets/curriculos/*
	Cache-Control: public, max-age=86400

/styles/*
	Cache-Control: public, max-age=86400, must-revalidate

/scripts/*
	Cache-Control: public, max-age=86400, must-revalidate

/scripts/projetos.json
	Cache-Control: public, max-age=300, must-revalidate

/*.html
	Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
	Cache-Control: public, max-age=3600

/robots.txt
	Cache-Control: public, max-age=86400
